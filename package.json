{
  "name": "@notifycal/shared",
  "version": "4.0.0",
  "main": "dist/index.js",
  "scripts": {
    "build": "rm -rf dist && tsc && tsc-alias",
    "lint": "eslint -c ./eslint.config.js",
    "lint:fix": "$npm_execpath run lint -- --fix",
    "prettier": "prettier . --check",
    "prettier:fix": "$npm_execpath run prettier -- --write",
    "test": "echo TODO",
    "checkCircularDeps": "madge --ts-config tsconfig.json --extensions ts --circular ."
  },
  "files": [
    "dist/**/*",
    "src/**/*"
  ],
  "type": "module",
  "types": "dist/index.d.ts",
  "exports": {
    "./utils": {
      "import": "./dist/utils/index.js",
      "types": "./dist/utils/index.d.ts"
    },
    "./types": {
      "import": "./dist/types/index.js",
      "types": "./dist/types/index.d.ts"
    },
    "./schemas": {
      "import": "./dist/schemas/index.js",
      "types": "./dist/schemas/index.d.ts"
    },
    "./i18n": {
      "import": "./dist/i18n/index.js",
      "types": "./dist/i18n/index.d.ts"
    }
  },
  "keywords": [],
  "author": "Notifycal",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Notifycal/shared.git"
  },
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/compat": "^1.2.7",
    "@types/luxon": "^3.4.2",
    "@types/node": "^22.10.10",
    "@vitest/eslint-plugin": "^1.1.36",
    "eslint": "^9.21.0",
    "eslint-config-prettier": "^10.0.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-unicorn": "^58.0.0",
    "madge": "^8.0.0",
    "prettier": "^3.4.2",
    "tsc-alias": "^1.8.10",
    "typescript-eslint": "^8.25.0"
  },
  "peerDependencies": {
    "luxon": "^3.5.0",
    "typescript": "^5.7.3",
    "zod": "3.24.2"
  }
}
